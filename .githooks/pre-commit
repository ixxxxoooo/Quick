#!/usr/bin/env bash
#
# Quick — pre-commit 钩子。
#
# 本项目规则：每次提交前只针对修改的包跑测试，不跑全量测试。
#
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACM)

if [[ -z "$staged" ]]; then
    exit 0
fi

# 提取暂存改动中涉及的 Packages/<Pkg> 包名（去重）
packages=()
while IFS= read -r pkg; do
    [[ -n "$pkg" ]] && packages+=("$pkg")
done < <(echo "$staged" | awk -F/ '$1 == "Packages" && NF >= 2 && ($0 ~ /\.swift$/ || $3 == "Package.swift") { print $2 }' | sort -u)

if [[ ${#packages[@]} -eq 0 ]]; then
    echo "▸ pre-commit: 本次改动未涉及 Packages/ 下的 Swift 源码，跳过包测试"
    exit 0
fi

echo "▸ pre-commit: 测试修改的包 (${packages[*]})"
if ! ./Scripts/run-tests.sh "${packages[@]}"; then
    echo
    echo "✗ 测试未通过，提交已中止。" >&2
    exit 1
fi

echo
echo "✓ pre-commit: 通过"
