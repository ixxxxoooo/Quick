#!/usr/bin/env bash
#
# Quick — commit-msg 钩子。
#
# 本项目规则：提交信息一律使用英文，格式遵循 Conventional Commits。
# 这个钩子把规则变成可执行的检查，而不是靠自觉。
#
# 通过「拒绝非 ASCII 主题行」来强制英文 —— 这比做语言检测可靠。
#
set -uo pipefail

readonly MSG_FILE="$1"
readonly TYPES='feat|fix|refactor|perf|docs|test|chore|build|ci|style|revert'

# ---------------------------------------------------------------------------
# 生成工具写的提交信息放行：merge / revert / fixup / squash
# ---------------------------------------------------------------------------
subject=$(head -1 "$MSG_FILE")

case "$subject" in
Merge* | Revert* | fixup!* | squash!* | amend!*)
    exit 0
    ;;
esac

# ---------------------------------------------------------------------------
# 1. 格式：<type>(<scope>): <subject>
# ---------------------------------------------------------------------------
if ! printf '%s' "$subject" | grep -qE "^($TYPES)(\([a-z0-9._-]+\))?!?: .+"; then
    echo "✗ 提交信息格式不符合 Conventional Commits。" >&2
    echo >&2
    echo "  你的主题行: $subject" >&2
    echo >&2
    echo "  期望格式: <type>(<scope>): <英文祈使句描述>" >&2
    echo "    type  : $TYPES" >&2
    echo "    scope : 模块 id 或区域，如 launcher / palette / quickui / core / tooling" >&2
    echo >&2
    echo "  示例: feat(clipboard): add pinning with a 30-entry history cap" >&2
    echo "        fix(palette): keep the panel on screen when the app deactivates" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 2. 英文：主题行不得含非 ASCII 字符
#
# 非 ASCII 基本等价于「写了中文」，这是本项目要拦的情况。
# 类型前缀、scope、以及冒号后的描述都必须在 ASCII 范围内。
# ---------------------------------------------------------------------------
if printf '%s' "$subject" | LC_ALL=C grep -q '[^ -~]'; then
    echo "✗ 提交信息必须使用英文（主题行检测到非 ASCII 字符）。" >&2
    echo >&2
    echo "  你的主题行: $subject" >&2
    echo >&2
    echo "  规则见 AGENTS.md：提交信息一律使用英文，历史要能被任何人、任何工具读懂。" >&2
    echo "  中文写在代码注释、文档和 PR 描述里，不写在提交主题里。" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 3. 主题行的基本卫生
# ---------------------------------------------------------------------------
# 句末不加句号
if printf '%s' "$subject" | grep -qE '\.$'; then
    echo "✗ 主题行末尾不要加句号。" >&2
    exit 1
fi

# 冒号后的描述用小写开头（专有名词例外无法自动判断，用大写会被拦）
desc=$(printf '%s' "$subject" | sed -E "s/^($TYPES)(\([a-z0-9._-]+\))?!?: //")
first_char=$(printf '%s' "$desc" | cut -c1)
if [[ "$first_char" =~ [A-Z] ]]; then
    # 允许全大写的专有名词缩写开头，如 API / URL / JSON / Quick
    if ! printf '%s' "$desc" | grep -qE '^(API|URL|JSON|SQL|HTML|CSS|UUID|HUD|OCR|AI|UI|macOS|Quick|Swift|Xcode|DesignTokens)\b'; then
        echo "✗ 主题行描述应以小写开头（祈使语气）。" >&2
        echo "  你的描述: $desc" >&2
        exit 1
    fi
fi

# 不要太长
if [[ ${#subject} -gt 72 ]]; then
    echo "✗ 主题行超过 72 字符（当前 ${#subject}）。细节写在正文里。" >&2
    exit 1
fi

exit 0
